# Business objective: document runtime configuration without including real secrets.
# Technical description: credentials and tenant-bound API principals are supplied only through environment/secret-manager injection.
ICA_PROVIDER=fixture
ICA_MODEL=fixture-canonicalizer-v1
ICA_DATABASE_PATH=.runtime/catalog.db
ICA_LOG_LEVEL=INFO
ICA_ENABLE_OCR=false
ICA_ENABLE_MODEL_EXTRACTION=true
ICA_AUTH_MODE=disabled

# Live provider example; replace pricing with the approved model contract.
ICA_MODEL_INPUT_COST_PER_MILLION=1.00
ICA_MODEL_OUTPUT_COST_PER_MILLION=4.00
ICA_MODEL_MAX_OUTPUT_TOKENS=350
ICA_MODEL_TIMEOUT_SECONDS=20
ICA_MODEL_MAX_RETRIES=2
OPENAI_API_KEY=replace_only_in_secret_manager

# Production API-key auth JSON is secret-manager material. Example shape only:
# {"replace-token":{"tenant_id":"testinger","roles":["processor","reviewer"]}}
ICA_API_KEYS_JSON={}
